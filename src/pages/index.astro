---
import { Icon } from "astro-icon/components";
import "../styles/global.css";
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="generator" content={Astro.generator} />
    <title>Bita - Buy it again</title>
    <meta name="description" content="Non-annoying shopping list" />
    <meta name="theme-color" content="#62748e" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />
    <meta name="apple-mobile-web-app-title" content="Bita" />
  </head>
  <body class="bg-site-background font-sans antialiased">
    <div
      x-data
      class="container mx-auto flex flex-col min-h-dvh bg-white border-x border-site-border"
    >
      <!-- Header -->
      <header
        class="bg-site-menu border-y border-site-border text-white px-4 pb-4 sticky top-0 z-20 p-4"
      >
        <div class="flex items-center justify-between">
          <Icon name="mdi:basket" class="text-white w-5 h-5" />

          <h1 class="text-2xl font-bold" title="Buy It Again">Bita</h1>
          <div>
            <span x-text="$store.bita.numChecked">?</span>
            /
            <span x-text="$store.bita.numTotal">?</span>
          </div>
        </div>
        <!-- <button
            @click="$store.bita.reset()"
            class="text-sm bg-white/20 hover:bg-white/30 active:bg-white/40 px-3 py-1.5 rounded-full transition font-medium"
            title="Alle Häkchen entfernen"
          >
            Reset
          </button> -->
        <!-- <p x-text="$store.bita.status" class="text-orange-100 text-sm mt-1"></p> -->
      </header>

      <!-- Empty state -->
      <div
        x-show="$store.bita.items.length === 0"
        x-cloak
        class="flex-1 flex flex-col items-center justify-center text-stone-400 px-8 text-center"
      >
        <span class="text-7xl mb-5">🛍️</span>
        <p class="text-xl font-semibold text-stone-500">Liste ist leer</p>
        <p class="text-sm mt-1">Füge unten einen Artikel hinzu</p>
      </div>

      <!-- Item list -->
      <main
        x-show="$store.bita.items.length > 0"
        x-cloak
        class="flex-1 px-4 py-3 space-y-2 overflow-y-auto"
      >
        <template x-for="item in $store.bita.sorted" :key="item.id">
          <div
            class="flex items-center gap-3 bg-site-background rounded px-4 py-3 border border-site-border"
          >
            <button
              @click="$store.bita.toggle(item.id)"
              class="w-7 h-7 rounded-full border shrink-0 flex items-center justify-center transition-all hover:border-form-border hover:bg-site-menu"
              :class="item.checked ? 'bg-green-800 border-green-900 text-white text-sm' : 'border-site-border'"
            >
              <span x-show="item.checked">✓</span>
            </button>
            <span
              x-text="item.name"
              class="flex-1 text-base leading-snug"
              :class="item.checked ? 'line-through text-stone-500' : 'text-stone-800'"
            ></span>
            <button
              @click="$store.bita.remove(item.id)"
              class="hover:bg-btn-hover active:bg-btn-active text-site-border font-bold w-8 h-8 rounded transition flex items-center justify-center shrink-0 border border-site-border"
            >
              <Icon
                name="mdi:trash"
                title="Remove"
                class="w-5 h-5"
              />
            </button>
          </div>
        </template>
      </main>

      <!-- Add item form -->
      <footer
        class="border-y border-site-border bg-site-menu px-4 py-3 sticky bottom-0 z-20"
      >
        <form
          x-data="{ newItem: '' }"
          @submit.prevent="$store.bita.add(newItem); newItem = ''"
          class="flex gap-2"
        >
          <input
            x-model="newItem"
            type="text"
            placeholder="Add new item ..."
            autocomplete="off"
            autocapitalize="sentences"
            spellcheck="false"
            class="flex-1 border border-form-border rounded px-4 py-3 text-base bg-form-background"
          />
          <button
            type="submit"
            class="bg-btn-background hover:bg-btn-hover active:bg-btn-active text-white font-bold w-12 h-12 rounded transition flex items-center justify-center shrink-0 border border-form-border"
          >
            <Icon
              name="mdi:basket-plus-outline"
              title="Add item to basket"
              class="text-white w-5 h-5"
            />
          </button>
        </form>
      </footer>
    </div>

    <script>
      import Alpine from "alpinejs";
      import persist from "@alpinejs/persist";

      type Item = {
        id: string;
        name: string;
        checked: boolean;
        createdAt: number;
      };

      Alpine.plugin(persist);

      // Typed const so TypeScript can infer `this` correctly in methods
      const bitaStore = {
        items: Alpine.$persist([] as Item[]).as("bita") as unknown as Item[],

        get sorted(): Item[] {
          return [
            ...this.items.filter((i) => !i.checked),
            ...this.items.filter((i) => i.checked),
          ];
        },

        get numTotal(): number {
          return this.items.length;
        },

        get numChecked(): number {
          return this.items.filter((i) => i.checked).length;
        },

        get status(): string {
          if (this.numTotal === 0) return "Shopping list is empty";
          if (this.numChecked === this.numTotal) return "Got all items 🎉";
          return `${this.numChecked} of ${this.numTotal} items in the basket`;
        },

        add(name: string): void {
          const trimmed = name.trim();
          if (!trimmed) return;
          this.items.push({
            id: crypto.randomUUID(),
            name: trimmed,
            checked: false,
            createdAt: Date.now(),
          });
        },

        toggle(id: string): void {
          const item = this.items.find((i) => i.id === id);
          if (item) item.checked = !item.checked;
        },

        remove(id: string): void {
          this.items = this.items.filter((i) => i.id !== id);
        },

        reset(): void {
          this.items.forEach((i) => {
            i.checked = false;
          });
        },
      };

      Alpine.store("bita", bitaStore);
      Alpine.start();
    </script>
  </body>
</html>
