---
import "../styles/global.css";
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="generator" content={Astro.generator} />
    <title>Bita – Buy it again</title>
    <meta name="description" content="Hosi Einkaufsliste" />
    <meta name="theme-color" content="#f97316" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />
    <meta name="apple-mobile-web-app-title" content="Bita" />
  </head>
  <body class="bg-stone-100 font-sans antialiased">
    <div x-data class="max-w-md mx-auto flex flex-col min-h-dvh">
      <!-- Header -->
      <header
        class="bg-orange-500 text-white px-4 pb-4 shadow-lg sticky top-0 z-20"
        style="padding-top: calc(env(safe-area-inset-top, 0px) + 1rem)"
      >
        <div class="flex items-center justify-between">
          <h1 class="text-2xl font-bold tracking-tight">🛒 Bita</h1>
          <button
            @click="$store.bita.reset()"
            class="text-sm bg-white/20 hover:bg-white/30 active:bg-white/40 px-3 py-1.5 rounded-full transition font-medium"
            title="Alle Häkchen entfernen"
          >
            Reset
          </button>
        </div>
        <p x-text="$store.bita.status" class="text-orange-100 text-sm mt-1"></p>
      </header>

      <!-- Empty state -->
      <div
        x-show="$store.bita.items.length === 0"
        x-cloak
        class="flex-1 flex flex-col items-center justify-center text-stone-400 px-8 text-center"
      >
        <span class="text-7xl mb-5">🛍️</span>
        <p class="text-xl font-semibold text-stone-500">Liste ist leer</p>
        <p class="text-sm mt-1">Füge unten einen Artikel hinzu</p>
      </div>

      <!-- Item list -->
      <main
        x-show="$store.bita.items.length > 0"
        x-cloak
        class="flex-1 px-4 py-3 space-y-2 overflow-y-auto"
      >
        <template x-for="item in $store.bita.sorted" :key="item.id">
          <div
            class="flex items-center gap-3 bg-white rounded-2xl px-4 py-3 shadow-sm border border-stone-100 transition-opacity"
            :class="{ 'opacity-50': item.checked }"
          >
            <button
              @click="$store.bita.toggle(item.id)"
              class="w-7 h-7 rounded-full border-2 flex-shrink-0 flex items-center justify-center transition-all"
              :class="item.checked ? 'bg-green-500 border-green-500 text-white text-sm' : 'border-stone-300 hover:border-orange-400'"
              :aria-label="item.checked ? 'Abhaken rückgängig' : 'Abhaken'"
            >
              <span x-show="item.checked">✓</span>
            </button>
            <span
              x-text="item.name"
              class="flex-1 text-base leading-snug"
              :class="item.checked ? 'line-through text-stone-400' : 'text-stone-800'"
            ></span>
            <button
              @click="$store.bita.remove(item.id)"
              class="text-stone-300 hover:text-red-400 active:text-red-600 transition text-2xl leading-none flex-shrink-0 -mr-1"
              aria-label="Entfernen">×</button
            >
          </div>
        </template>
      </main>

      <!-- Add item form -->
      <footer
        class="border-t border-stone-200 bg-white px-4 py-3 sticky bottom-0 z-20 shadow-[0_-1px_8px_rgba(0,0,0,0.06)]"
        style="padding-bottom: calc(env(safe-area-inset-bottom, 0px) + 0.75rem)"
      >
        <form
          x-data="{ newItem: '' }"
          @submit.prevent="$store.bita.add(newItem); newItem = ''"
          class="flex gap-2"
        >
          <input
            x-model="newItem"
            type="text"
            placeholder="Artikel hinzufügen…"
            autocomplete="off"
            autocapitalize="sentences"
            spellcheck="false"
            class="flex-1 border border-stone-300 rounded-2xl px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-orange-400 focus:border-transparent bg-stone-50"
          />
          <button
            type="submit"
            class="bg-orange-500 hover:bg-orange-600 active:bg-orange-700 text-white font-bold w-12 h-12 rounded-2xl transition text-2xl flex items-center justify-center flex-shrink-0 shadow-sm"
            aria-label="Hinzufügen"
          >
            +
          </button>
        </form>
      </footer>
    </div>

    <script>
      import Alpine from "alpinejs";
      import persist from "@alpinejs/persist";

      type Item = {
        id: string;
        name: string;
        checked: boolean;
        createdAt: number;
      };

      Alpine.plugin(persist);

      // Typed const so TypeScript can infer `this` correctly in methods
      const bitaStore = {
        items: Alpine.$persist([] as Item[]).as("bita") as unknown as Item[],

        get sorted(): Item[] {
          return [
            ...this.items.filter((i) => !i.checked),
            ...this.items.filter((i) => i.checked),
          ];
        },

        get status(): string {
          const { items } = this;
          const total = items.length;
          const checked = items.filter((i) => i.checked).length;
          if (total === 0) return "Noch nichts auf der Liste";
          if (checked === total) return "Alles erledigt – guten Einkauf! 🎉";
          return `${checked} von ${total} Artikeln im Korb`;
        },

        add(name: string): void {
          const trimmed = name.trim();
          if (!trimmed) return;
          this.items.push({
            id: crypto.randomUUID(),
            name: trimmed,
            checked: false,
            createdAt: Date.now(),
          });
        },

        toggle(id: string): void {
          const item = this.items.find((i) => i.id === id);
          if (item) item.checked = !item.checked;
        },

        remove(id: string): void {
          this.items = this.items.filter((i) => i.id !== id);
        },

        reset(): void {
          this.items.forEach((i) => {
            i.checked = false;
          });
        },
      };

      Alpine.store("bita", bitaStore);
      Alpine.start();
    </script>
  </body>
</html>
