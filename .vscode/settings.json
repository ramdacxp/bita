{
  // supress CSS error for Tailwind @theme
  "css.lint.unknownAtRules": "ignore",
  // spell checker
  "cSpell.language": "en, de-de",
  "cSpell.customDictionaries": {
    "homepageDict": {
      "name": "Bita Dictionary",
      "path": "${workspaceFolder}/.vscode/dictionary.txt",
      "scope": "workspace",
      "addWords": true
    }
  }
}